# Source/cache convergence specimen; the full RF graph witness is separate.
@beta_policy = 3
scenario = rehearsal_ingress_cache {
  static_galaxy_scenario = lattice { namespace = "cache_base" source_json = "rehearsal_ingress_cache.base.json" map_quality_status = PASS }
  owner = alpha { display_name = "Alpha" }
  owner = beta { display_name = "Beta" }
  planet_surface_payload = neutral { applies_to = neutral_systems planets_per_system_min = 1 surface_grid = "1x1" factory_min = 0 cohort_min = 0 }
  location = alpha_0 { system_target = "row0_col0" }
  location = alpha_1 { system_target = "row0_col1" }
  location = alpha_2 { system_target = "row0_col2" }
  location = alpha_3 { system_target = "row0_col3" }
  location = alpha_4 { system_target = "row0_col4" }
  location = beta_0 { system_target = "row1_col0" }
  location = beta_1 { system_target = "row1_col1" }
  location = beta_2 { system_target = "row1_col2" }
  location = beta_3 { system_target = "row1_col3" }
  location = beta_4 { system_target = "row1_col4" }
  field_economy = authored { namespace = "cache_economy"
    field_resource_quantity = alpha_0 { location = "alpha_0" resource = "energy" amount = 5 }
    field_resource_quantity = alpha_1 { location = "alpha_1" resource = "energy" amount = 6 }
    field_resource_quantity = alpha_2 { location = "alpha_2" resource = "energy" amount = 7 }
    field_resource_quantity = alpha_3 { location = "alpha_3" resource = "energy" amount = 8 }
    field_resource_quantity = alpha_4 { location = "alpha_4" resource = "energy" amount = 0 }
    stockpile_silo = alpha_silo { owner = "alpha" resource = "energy" current = 10 }
    owner_policy_overlay = alpha_policy { owner = "alpha" targets_property = "cache_economy::alpha_energy_stockpile" amount_add = 2 }
    field_resource_quantity = beta_0 { location = "beta_0" resource = "energy" amount = 5 }
    field_resource_quantity = beta_1 { location = "beta_1" resource = "energy" amount = 6 }
    field_resource_quantity = beta_2 { location = "beta_2" resource = "energy" amount = 7 }
    field_resource_quantity = beta_3 { location = "beta_3" resource = "energy" amount = 8 }
    field_resource_quantity = beta_4 { location = "beta_4" resource = "energy" amount = 0 }
    stockpile_silo = beta_silo { owner = "beta" resource = "energy" current = 10 }
    owner_policy_overlay = beta_policy { owner = "beta" targets_property = "cache_economy::beta_energy_stockpile" amount_add = @beta_policy }
  }
}
